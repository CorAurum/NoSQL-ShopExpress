              "raw": "{\n  \"usuario_id\": \"{{usuario_id}}\",\n  \"items\": [\n    {\n      \"producto_id\": \"{{producto_id}}\",\n      \"cantidad\": 1\n    }\n  ],\n  \"pago\": {\n    \"metodo\": \"TARJETA_CREDITO\",\n    \"token_tarjeta\": \"tok_visa_ok\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
