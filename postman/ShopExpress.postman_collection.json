          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('500 (fallo simulado)', () => pm.response.to.have.status(500));",
                  "const p = pm.response.json().pedido;",
                  "pm.test('Pedido CANCELADO', () => pm.expect(p.estado).to.eql('CANCELADO'));",
                  "pm.test('Pago REEMBOLSADO', () => pm.expect(p.pago.estado_pago).to.eql('REEMBOLSADO'));",
                  "pm.test('Compensaciones en orden inverso', () => {",
                  "  const comp = p.pasos_saga.filter(x => x.paso.startsWith('COMPENSAR_')).map(x => x.paso);",
                  "  pm.expect(comp).to.eql(['COMPENSAR_PROCESAR_PAGO','COMPENSAR_RESERVAR_STOCK','COMPENSAR_CREAR_PEDIDO']);",
                  "});"
                ]
              }
            }
