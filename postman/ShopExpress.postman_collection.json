    {
      "name": "3. Servicio de Pedidos y Pagos (SAGA + CoR)",
      "item": [
        {
          "name": "SAGA exitosa: crear pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{pedidos_url}}/api/pedidos",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": \"{{usuario_id}}\",\n  \"items\": [\n    {\n      \"producto_id\": \"{{producto_id}}\",\n      \"cantidad\": 2\n    }\n  ],\n  \"pago\": {\n    \"metodo\": \"TARJETA_CREDITO\",\n    \"token_tarjeta\": \"tok_visa_ok\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const p = pm.response.json();",
                  "pm.test('Estado CONFIRMADO', () => pm.expect(p.estado).to.eql('CONFIRMADO'));",
                  "pm.test('Pago APROBADO', () => pm.expect(p.pago.estado_pago).to.eql('APROBADO'));",
                  "pm.test('Total calculado con precio del catálogo', () => pm.expect(Number(p.total)).to.eql(80));",
                  "pm.test('Pasos de la cadena en orden', () => {",
                  "  const pasos = p.pasos_saga.map(x => x.paso);",
                  "  pm.expect(pasos).to.eql(['VALIDAR_DATOS','VALIDAR_USUARIO','VALIDAR_STOCK','CALCULAR_TOTAL','CREAR_PEDIDO','RESERVAR_STOCK','PROCESAR_PAGO','CONFIRMAR_PEDIDO','REGISTRAR_HISTORIAL']);",
                  "});",
                  "pm.collectionVariables.set('pedido_id', p.pedido_id);"
                ]
              }
            }
          ]
        },
