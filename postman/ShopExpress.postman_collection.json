{
  "info": {
    "name": "ShopExpress - Tarea 2",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Pruebas de los tres microservicios. Ejecutar en orden (Runner o newman): cada carpeta usa variables creadas por la anterior."
  },
  "item": [
    {
      "name": "1. Servicio de Usuarios",
      "item": [
        {
          "name": "Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{usuarios_url}}/api/usuarios",
              "host": [
                "{{usuarios_url}}"
              ],
              "path": [
                "api",
                "usuarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo_documento\": \"CI\",\n  \"nro_documento\": \"{{nro_documento}}\",\n  \"nombre\": \"Ana\",\n  \"apellido\": \"García\",\n  \"email\": \"{{email}}\",\n  \"direcciones\": [\n    {\n      \"calle\": \"18 de Julio 1234\",\n      \"ciudad\": \"Montevideo\",\n      \"codigo_postal\": \"11100\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Date.now();",
                  "pm.collectionVariables.set('email', `ana.${n}@example.com`);",
                  "pm.collectionVariables.set('nro_documento', String(n).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const u = pm.response.json();",
                  "pm.test('Tiene id con prefijo usr_', () => pm.expect(u.id).to.match(/^usr_/));",
                  "pm.test('Documento enmascarado', () => pm.expect(u.nro_documento).to.match(/^\\*+\\d{3}$/));",
                  "pm.test('Direcciones embebidas', () => pm.expect(u.direcciones).to.have.lengthOf(1));",
                  "pm.collectionVariables.set('usuario_id', u.id);"
                ]
              }
            }
          ]
        },
