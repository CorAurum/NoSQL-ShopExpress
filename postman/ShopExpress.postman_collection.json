              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": \"{{usuario_id}}\",\n  \"items\": [\n    {\n      \"producto_id\": \"{{producto_escaso_id}}\",\n      \"cantidad\": 5\n    }\n  ],\n  \"pago\": {\n    \"metodo\": \"TARJETA_CREDITO\",\n    \"token_tarjeta\": \"tok_visa_ok\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
                  "pm.test('Código STOCK_INSUFICIENTE', () => pm.expect(pm.response.json().error).to.eql('STOCK_INSUFICIENTE'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Pago rechazado -> compensa la reserva (402)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{pedidos_url}}/api/pedidos",
              "host": [
                "{{pedidos_url}}"
              ],
              "path": [
                "api",
                "pedidos"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario_id\": \"{{usuario_id}}\",\n  \"items\": [\n    {\n      \"producto_id\": \"{{producto_id}}\",\n      \"cantidad\": 1\n    }\n  ],\n  \"pago\": {\n    \"metodo\": \"TARJETA_CREDITO\",\n    \"token_tarjeta\": \"tok_rechazada\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('402 Payment Required', () => pm.response.to.have.status(402));",
                  "const body = pm.response.json();",
                  "pm.test('Código PAGO_RECHAZADO', () => pm.expect(body.error).to.eql('PAGO_RECHAZADO'));",
                  "pm.test('Pedido CANCELADO', () => pm.expect(body.pedido.estado).to.eql('CANCELADO'));",
                  "pm.test('Se liberó la reserva', () => {",
                  "  const c = body.pedido.pasos_saga.find(x => x.paso === 'COMPENSAR_RESERVAR_STOCK');",
